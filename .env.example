# --- Боты ---------------------------------------------------------------
# Личный бот для покупки звёзд себе (bot.py)
BOT_TOKEN=
# Магазин (shop_bot.py). Обязательно ОТДЕЛЬНЫЙ токен: один токен нельзя
# опрашивать из двух процессов одновременно.
SHOP_BOT_TOKEN=

# Telegram ID администраторов через запятую. Им приходят уведомления о заказах,
# и только они могут пользоваться bot.py.
ADMIN_IDS=

# --- Канал обязательной подписки ----------------------------------------
# Бот должен быть администратором канала, иначе get_chat_member всегда падает.
CHANNEL_ID=@XAR1ZMA_SHOP
CHANNEL_URL=https://t.me/XAR1ZMA_SHOP

# Автор бота: @username без собачки. Виден строкой в профиле.
DEVELOPER_USERNAME=zheka_en

# Канал с отзывами. Бот должен быть его администратором.
REVIEWS_CHANNEL_ID=@xar1zma_test
# Ссылка для кнопки «Отзывы» в разделе «Ещё». Для канала с @именем считается сама,
# задавать нужно только для приватного канала с числовым id.
#REVIEWS_CHANNEL_URL=https://t.me/+abcdef
# Прибавляется к номеру отзыва, чтобы нумерация не начиналась с единицы
REVIEW_NUMBER_OFFSET=0

# --- Реквизиты оплаты ---------------------------------------------------
CARD_NUMBER=
CARD_HOLDER=

# --- Параметры заказов --------------------------------------------------
DB_PATH=shop.db
# Через сколько минут неоплаченный заказ отменяется
ORDER_TIMEOUT_MINUTES=30
# Допустимый разрыв между созданием заказа и временем платежа в квитанции
PAYMENT_TOLERANCE_MINUTES=15
# --- TON ----------------------------------------------------------------
# Без ключа toncenter даёт ~1 запрос/сек, и выдача звёзд падает с 429.
# Бесплатный ключ: @tonapibot в Telegram.
TONCENTER_API_KEY=
TONCENTER_RPS=8

# До какой суммы в гривнах выдавать автоматически по PDF-квитанции.
# Текстовый слой PDF редактируем, поэтому крупные заказы уходят на подтверждение в админку.
# Ссылок Monobank не касается — там данные берутся с сайта банка.
PDF_AUTO_LIMIT=200

# 1 — тестовый режим: квитанции проверяются полностью и присылают подробный отчёт,
# но заказ не оплачивается и звёзды не выдаются. Переключается в админке.
TEST_MODE=0

# 1 — звёзды выдаются автоматически через Fragment, 0 — только уведомление админу
STARS_AUTO_DELIVERY=1
MIN_STARS=50
